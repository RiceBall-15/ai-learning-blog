---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categoryMeta } from '../content/config';

// 动态获取所有分类的文章
const collectionData: Record<string, { name: string; icon: string; description: string; posts: any[] }> = {};

for (const [key, meta] of Object.entries(categoryMeta)) {
  const posts = (await getCollection(key as any))
    .filter((post: any) => !post.data.draft)
    .sort((a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf());
  
  collectionData[key] = {
    ...meta,
    posts,
  };
}

// 合并所有文章并按日期排序
const allPosts = Object.values(collectionData)
  .flatMap(c => c.posts)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 获取所有标签
const allTags = new Set<string>();
allPosts.forEach(post => {
  post.data.tags.forEach((tag: string) => allTags.add(tag));
});

const totalPosts = allPosts.length;
const activeCollections = Object.entries(collectionData).filter(([_, c]) => c.posts.length > 0);

// 分页配置
const POSTS_PER_PAGE = 12;
const currentPage = parseInt(Astro.url.searchParams.get('page') || '1');
const categoryFilter = Astro.url.searchParams.get('category') || '';

// 根据分类筛选文章
let filteredPosts = allPosts;
if (categoryFilter && collectionData[categoryFilter]) {
  filteredPosts = collectionData[categoryFilter].posts;
}

const totalPages = Math.ceil(filteredPosts.length / POSTS_PER_PAGE);
const startIndex = (currentPage - 1) * POSTS_PER_PAGE;
const endIndex = startIndex + POSTS_PER_PAGE;
const currentPosts = filteredPosts.slice(startIndex, endIndex);

// 生成分页URL
function getPageUrl(page: number) {
  const params = new URLSearchParams();
  if (page > 1) params.set('page', page.toString());
  if (categoryFilter) params.set('category', categoryFilter);
  const queryString = params.toString();
  return `/ai-learning-blog/${queryString ? '?' + queryString : ''}`;
}
---

<Layout title="首页 - AI 深度学习笔记">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <h1 class="hero-title">AI 深度学习笔记</h1>
      <p class="hero-subtitle">深入探索大语言模型、框架应用和训练技术的学习之路</p>
      <div class="hero-stats">
        <span class="stat-badge">{totalPosts} 篇文章</span>
        <span class="stat-badge">{activeCollections.length} 个系列</span>
        <span class="stat-badge">{allTags.size} 个标签</span>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <main class="main-content">
    <!-- Category Filter -->
    <div class="category-filter">
      <a 
        href="/ai-learning-blog/" 
        class={`filter-btn ${!categoryFilter ? 'active' : ''}`}
      >
        全部
      </a>
      {activeCollections.map(([key, meta]) => (
        <a 
          href={`/ai-learning-blog/?category=${key}`} 
          class={`filter-btn ${categoryFilter === key ? 'active' : ''}`}
        >
          <span class="filter-icon">{meta.icon}</span>
          {meta.name}
          <span class="filter-count">{meta.posts.length}</span>
        </a>
      ))}
    </div>

    <div class="content-grid">
      <!-- Articles Section -->
      <section class="articles-section">
        <div class="articles-header">
          <h2 class="section-title">
            {categoryFilter && collectionData[categoryFilter] 
              ? `${collectionData[categoryFilter].icon} ${collectionData[categoryFilter].name}`
              : '📚 最新文章'
            }
          </h2>
          <span class="posts-count">
            共 {filteredPosts.length} 篇，第 {currentPage}/{totalPages} 页
          </span>
        </div>

        <div class="articles-grid">
          {currentPosts.map((post) => (
            <article class="article-card">
              <a href={`/ai-learning-blog/${post.collection}/${post.slug}`} class="article-link">
                <div class="article-meta">
                  <time class="article-date">{post.data.date.toLocaleDateString('zh-CN')}</time>
                  {post.data.category && <span class="article-category">{post.data.category}</span>}
                </div>
                <h3 class="article-title">{post.data.title}</h3>
                {post.data.description && (
                  <p class="article-excerpt">{post.data.description}</p>
                )}
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="article-tags">
                    {post.data.tags.slice(0, 3).map((tag: string) => (
                      <span class="tag">#{tag}</span>
                    ))}
                  </div>
                )}
              </a>
            </article>
          ))}
        </div>

        <!-- Pagination -->
        {totalPages > 1 && (
          <nav class="pagination">
            <a 
              href={currentPage > 1 ? getPageUrl(currentPage - 1) : '#'} 
              class={`page-btn prev ${currentPage <= 1 ? 'disabled' : ''}`}
            >
              ← 上一页
            </a>
            
            <div class="page-numbers">
              {Array.from({ length: totalPages }, (_, i) => i + 1).map(page => (
                <a 
                  href={getPageUrl(page)} 
                  class={`page-num ${page === currentPage ? 'active' : ''}`}
                >
                  {page}
                </a>
              ))}
            </div>
            
            <a 
              href={currentPage < totalPages ? getPageUrl(currentPage + 1) : '#'} 
              class={`page-btn next ${currentPage >= totalPages ? 'disabled' : ''}`}
            >
              下一页 →
            </a>
          </nav>
        )}
      </section>

      <!-- Sidebar -->
      <aside class="sidebar">
        <div class="sidebar-card">
          <h3 class="sidebar-title">分类导航</h3>
          <nav class="category-nav">
            {activeCollections.map(([key, meta]) => (
              <a href={`/ai-learning-blog/?category=${key}`} class="nav-item">
                <span class="nav-icon">{meta.icon}</span>
                <span class="nav-text">{meta.name}</span>
                <span class="nav-count">{meta.posts.length}</span>
              </a>
            ))}
          </nav>
        </div>

        <div class="sidebar-card">
          <h3 class="sidebar-title">热门标签</h3>
          <div class="tags-cloud">
            {Array.from(allTags).slice(0, 12).map(tag => (
              <a href={`/ai-learning-blog/tags/${tag}`} class="tag-pill">#{tag}</a>
            ))}
          </div>
        </div>

        <div class="sidebar-card">
          <h3 class="sidebar-title">关于</h3>
          <p class="about-text">
            这是我的AI技术学习笔记，记录大语言模型、Agent系统、推理框架等前沿技术的深度研究和实践经验。
          </p>
        </div>
      </aside>
    </div>
  </main>
</Layout>

<style>
  /* ==================== Hero Section ==================== */
  .hero {
    background: linear-gradient(135deg, #f8fffe 0%, #ffffff 100%);
    padding: 4rem 2rem;
    text-align: center;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .hero-title {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: 3.5rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -1.28px;
    color: #0d0d0d;
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.5;
    color: #666666;
    margin-bottom: 2rem;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .stat-badge {
    background: #d4fae8;
    color: #0fa76e;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
  }

  /* ==================== Category Filter ==================== */
  .category-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: #333333;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    background: #f5f5f5;
    border-color: rgba(0, 0, 0, 0.12);
  }

  .filter-btn.active {
    background: #18E299;
    color: #0d0d0d;
    border-color: #18E299;
  }

  .filter-icon {
    font-size: 1rem;
  }

  .filter-count {
    background: rgba(0, 0, 0, 0.08);
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .filter-btn.active .filter-count {
    background: rgba(0, 0, 0, 0.15);
  }

  /* ==================== Main Content ==================== */
  .main-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 3rem;
  }

  /* ==================== Articles Section ==================== */
  .articles-section {
    min-height: 60vh;
  }

  .articles-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .section-title {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #0d0d0d;
    margin: 0;
  }

  .posts-count {
    font-size: 0.875rem;
    color: #666666;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

  .article-card {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.05);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.2s ease;
    box-shadow: rgba(0, 0, 0, 0.03) 0px 2px 4px;
  }

  .article-card:hover {
    border-color: rgba(0, 0, 0, 0.08);
    box-shadow: rgba(0, 0, 0, 0.06) 0px 4px 8px;
    transform: translateY(-2px);
  }

  .article-link {
    display: block;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
    color: #888888;
  }

  .article-date {
    font-weight: 500;
  }

  .article-category {
    background: #f5f5f5;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
  }

  .article-title {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    color: #0d0d0d;
    margin-bottom: 0.5rem;
    letter-spacing: -0.2px;
  }

  .article-card:hover .article-title {
    color: #18E299;
  }

  .article-excerpt {
    font-size: 0.875rem;
    line-height: 1.5;
    color: #666666;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    color: #0fa76e;
    background: #d4fae8;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  /* ==================== Pagination ==================== */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 2rem 0;
    border-top: 1px solid rgba(0, 0, 0, 0.05);
  }

  .page-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: #333333;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .page-btn:hover:not(.disabled) {
    background: #f5f5f5;
    border-color: rgba(0, 0, 0, 0.12);
    color: #0d0d0d;
  }

  .page-btn.disabled {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }

  .page-numbers {
    display: flex;
    gap: 0.5rem;
  }

  .page-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    font-size: 0.875rem;
    font-weight: 500;
    color: #333333;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .page-num:hover {
    background: #f5f5f5;
    border-color: rgba(0, 0, 0, 0.12);
  }

  .page-num.active {
    background: #18E299;
    color: #0d0d0d;
    border-color: #18E299;
    font-weight: 600;
  }

  /* ==================== Sidebar ==================== */
  .sidebar {
    position: sticky;
    top: 2rem;
    height: fit-content;
  }

  .sidebar-card {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.05);
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow: rgba(0, 0, 0, 0.03) 0px 2px 4px;
  }

  .sidebar-title {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    color: #0d0d0d;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .category-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: 8px;
    text-decoration: none;
    color: #333333;
    transition: background 0.2s ease;
  }

  .nav-item:hover {
    background: #f5f5f5;
    color: #18E299;
  }

  .nav-icon {
    font-size: 1.125rem;
  }

  .nav-text {
    flex: 1;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .nav-count {
    background: rgba(0, 0, 0, 0.05);
    padding: 0.25rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    color: #666666;
  }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-pill {
    background: #f5f5f5;
    color: #333333;
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .tag-pill:hover {
    background: #d4fae8;
    color: #0fa76e;
  }

  .about-text {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #666666;
  }

  /* ==================== Responsive ==================== */
  @media (max-width: 768px) {
    .hero {
      padding: 3rem 1.5rem;
    }

    .hero-title {
      font-size: 2.5rem;
    }

    .hero-subtitle {
      font-size: 1.125rem;
    }

    .category-filter {
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 0.5rem;
      -webkit-overflow-scrolling: touch;
    }

    .filter-btn {
      flex-shrink: 0;
    }

    .main-content {
      padding: 1.5rem;
    }

    .content-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .sidebar {
      position: static;
    }

    .articles-grid {
      grid-template-columns: 1fr;
    }

    .articles-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .pagination {
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .page-btn {
      padding: 0.625rem 1rem;
      font-size: 0.8125rem;
    }

    .page-num {
      width: 2.25rem;
      height: 2.25rem;
      font-size: 0.8125rem;
    }
  }
</style>
