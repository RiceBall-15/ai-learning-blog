---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categoryMeta } from '../content/config';

// 动态获取所有分类的文章
const collectionData: Record<string, { name: string; icon: string; description: string; posts: any[] }> = {};

for (const [key, meta] of Object.entries(categoryMeta)) {
  const posts = (await getCollection(key as any))
    .filter((post: any) => !post.data.draft)
    .sort((a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf());
  
  collectionData[key] = {
    ...meta,
    posts,
  };
}

// 合并所有文章并按日期排序
const allPosts = Object.values(collectionData)
  .flatMap(c => c.posts)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 获取所有标签
const allTags = new Set<string>();
allPosts.forEach(post => {
  post.data.tags.forEach((tag: string) => allTags.add(tag));
});

const totalPosts = allPosts.length;
const activeCollections = Object.entries(collectionData).filter(([_, c]) => c.posts.length > 0);

// 准备JSON数据供JavaScript使用
const postsData = allPosts.map(post => ({
  slug: post.slug,
  collection: post.collection,
  title: post.data.title,
  description: post.data.description || '',
  date: post.data.date.toISOString(),
  tags: post.data.tags || [],
  category: post.data.category || '',
}));

const categoriesData = Object.fromEntries(
  activeCollections.map(([key, meta]) => [
    key, 
    { 
      name: meta.name, 
      icon: meta.icon, 
      count: meta.posts.length,
      posts: meta.posts.map(p => p.slug)
    }
  ])
);
---

<Layout title="AI 深度学习笔记">
  <!-- Hero Banner -->
  <section class="hero-banner">
    <div class="banner-bg"></div>
    <div class="banner-content">
      <div class="banner-text">
        <h1 class="banner-title">
          <span class="title-line">深入探索</span>
          <span class="title-line accent">AI 技术世界</span>
        </h1>
        <p class="banner-subtitle">
          <span class="typing-text" id="typingText"></span>
          <span class="cursor">|</span>
        </p>
        <div class="banner-stats">
          <div class="stat-item">
            <span class="stat-number">{totalPosts}</span>
            <span class="stat-label">篇文章</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-number">{activeCollections.length}</span>
            <span class="stat-label">个系列</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-number">{allTags.size}</span>
            <span class="stat-label">个标签</span>
          </div>
        </div>
      </div>
      <div class="banner-visual">
        <div class="code-window">
          <div class="window-header">
            <div class="dot red"></div>
            <div class="dot yellow"></div>
            <div class="dot green"></div>
          </div>
          <div class="window-content">
            <div class="code-line">
              <span class="line-number">1</span>
              <span class="code-text"><span class="keyword">const</span> <span class="variable">aiKnowledge</span> = <span class="function">explore</span>();</span>
            </div>
            <div class="code-line">
              <span class="line-number">2</span>
              <span class="code-text"><span class="keyword">await</span> <span class="variable">aiKnowledge</span>.<span class="function">deepLearn</span>();</span>
            </div>
            <div class="code-line">
              <span class="line-number">3</span>
              <span class="code-text"><span class="comment">// 持续学习，不断进化</span></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content - 两列布局 -->
  <main class="main-content">
    <div class="main-container">
      <!-- 左侧：文章列表 -->
      <section class="articles-section">
        <div class="section-header">
          <h2 class="section-title">
            <span class="title-icon">📝</span>
            <span id="sectionTitle">最新文章</span>
          </h2>
          <div class="filter-tabs">
            <button class="filter-tab active" data-category="all">全部</button>
            {activeCollections.map(([key, meta]) => (
              <button class="filter-tab" data-category={key}>
                <span class="tab-icon">{meta.icon}</span>
                <span class="tab-text">{meta.name}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="articles-list" id="articlesList">
          {allPosts.slice(0, 10).map((post, index) => (
            <article class="article-item" style={`--delay: ${index * 0.05}s`}>
              <a href={`/ai-learning-blog/${post.collection}/${post.slug}`} class="article-link">
                <div class="article-meta">
                  <time class="article-date">
                    {post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
                  </time>
                  {post.data.category && (
                    <span class="article-category">{post.data.category}</span>
                  )}
                </div>
                <h3 class="article-title">{post.data.title}</h3>
                {post.data.description && (
                  <p class="article-excerpt">{post.data.description.substring(0, 100)}...</p>
                )}
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="article-tags">
                    {post.data.tags.slice(0, 3).map((tag: string) => (
                      <span class="tag">#{tag}</span>
                    ))}
                  </div>
                )}
              </a>
            </article>
          ))}
        </div>

        <!-- 分页 -->
        <nav class="pagination" id="pagination">
          <button class="page-btn prev disabled" id="prevBtn">上一页</button>
          <div class="page-numbers" id="pageNumbers"></div>
          <button class="page-btn next" id="nextBtn">下一页</button>
        </nav>
      </section>

      <!-- 右侧：侧边栏 -->
      <aside class="sidebar">
        <!-- 公告 -->
        <div class="sidebar-card">
          <h3 class="sidebar-title">
            <span class="title-icon">📢</span>
            <span>公告</span>
          </h3>
          <div class="announcement">
            <p>欢迎访问我的AI技术博客！这里记录了大语言模型、Agent系统、推理框架等前沿技术的深度研究和实践经验。</p>
          </div>
        </div>

        <!-- 学习系列 -->
        <div class="sidebar-card">
          <h3 class="sidebar-title">
            <span class="title-icon">📚</span>
            <span>学习系列</span>
          </h3>
          <nav class="category-list">
            {activeCollections.map(([key, meta]) => (
              <a href="#" class="category-item" data-category={key}>
                <span class="category-icon">{meta.icon}</span>
                <span class="category-name">{meta.name}</span>
                <span class="category-count">{meta.posts.length}</span>
              </a>
            ))}
          </nav>
        </div>

        <!-- 热门标签 -->
        <div class="sidebar-card">
          <h3 class="sidebar-title">
            <span class="title-icon">🏷️</span>
            <span>热门标签</span>
          </h3>
          <div class="tags-cloud">
            {Array.from(allTags).slice(0, 20).map(tag => (
              <a href={`/ai-learning-blog/tags/${tag}`} class="tag-item">
                #{tag}
              </a>
            ))}
          </div>
        </div>

        <!-- 个人网站 -->
        <div class="sidebar-card">
          <h3 class="sidebar-title">
            <span class="title-icon">🔗</span>
            <span>个人网站</span>
          </h3>
          <div class="website-links">
            <a href="https://github.com/RiceBall-15" target="_blank" rel="noopener" class="website-link">
              <span class="link-icon">🐱</span>
              <span class="link-text">GitHub</span>
            </a>
          </div>
        </div>
      </aside>
    </div>
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-content">
      <div class="footer-brand">
        <span class="brand-icon">🤖</span>
        <span class="brand-text">AI 深度学习笔记</span>
      </div>
      <p class="footer-description">记录AI技术学习之路，分享深度研究心得</p>
      <div class="footer-links">
        <a href="https://github.com/RiceBall-15" target="_blank" rel="noopener">GitHub</a>
        <a href="https://github.com/RiceBall-15/ai-learning-blog" target="_blank" rel="noopener">博客源码</a>
      </div>
    </div>
  </footer>
</Layout>

