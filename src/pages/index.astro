    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    color: #0fa76e;
    background: #d4fae8;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  /* ==================== Pagination ==================== */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 2rem 0;
    border-top: 1px solid rgba(0, 0, 0, 0.05);
  }

  .page-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 9999px;
    font-size: 0.875rem;
