---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { collections, categoryMeta } from '../content/config';

// 动态获取所有分类的文章
const collectionData: Record<string, { name: string; icon: string; description: string; posts: any[] }> = {};

for (const [key, meta] of Object.entries(categoryMeta)) {
  const posts = (await getCollection(key as any))
    .filter((post: any) => !post.data.draft)
    .sort((a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf());
  
  collectionData[key] = {
    ...meta,
    posts,
  };
}

// 合并所有文章并按日期排序
const allPosts = Object.values(collectionData)
  .flatMap(c => c.posts)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 获取所有标签
const allTags = new Set<string>();
allPosts.forEach(post => {
  post.data.tags.forEach((tag: string) => allTags.add(tag));
});

const totalPosts = allPosts.length;
const activeCollections = Object.entries(collectionData).filter(([_, c]) => c.posts.length > 0);
---

<Layout title="首页 - AI 深度学习笔记">
  <div style="display: grid; grid-template-columns: 3fr 1fr; gap: 2rem;">
    <div>
      <h1 style="font-size: 2.5rem; margin-bottom: 1rem; color: var(--text-primary);">
        🚀 AI 深度学习笔记
      </h1>
      <p style="color: var(--text-secondary); margin-bottom: 2rem; font-size: 1.1rem; line-height: 1.8;">
        深入探索大语言模型、框架应用和训练技术的学习之路
      </p>

      <!-- 学习系列卡片 - 动态显示所有分类 -->
      <div style="background: var(--bg-tertiary); border: 1px solid var(--border); border-radius: 8px; padding: 1.5rem; margin-bottom: 3rem;">
        <h2 style="font-size: 1.2rem; margin-bottom: 1rem; color: var(--text-primary);">📖 学习系列</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
          {activeCollections.map(([key, meta]) => (
            <a 
              href={`/ai-learning-blog/#${key}`} 
              style="background: var(--bg-secondary); padding: 1rem; border-radius: 6px; text-decoration: none; color: var(--text-primary); transition: transform 0.3s; border: 1px solid var(--border);"
            >
              <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">{meta.icon}</div>
              <div style="font-weight: bold; margin-bottom: 0.25rem;">{meta.name}</div>
              <div style="font-size: 0.85rem; color: var(--text-secondary);">{meta.posts.length} 篇文章</div>
            </a>
          ))}
        </div>
      </div>

      {totalPosts === 0 ? (
        <p style="color: var(--text-secondary);">暂无文章</p>
      ) : (
        <div>
          {/* 按分类动态显示文章 */}
          {activeCollections.map(([key, meta]) => (
            <div key={key} style="margin-bottom: 3rem;">
              <h2 id={key} style="font-size: 1.8rem; margin-bottom: 1.5rem; color: var(--accent); padding-top: 2rem; display: flex; align-items: center; gap: 0.5rem;">
                <span>{meta.icon}</span>
                <span>{meta.name}</span>
                <span style="font-size: 0.9rem; color: var(--text-secondary); font-weight: normal;">({meta.posts.length})</span>
              </h2>
              <p style="color: var(--text-secondary); margin-bottom: 1.5rem; font-size: 0.95rem;">
                {meta.description}
              </p>

              {meta.posts.map((post) => (
                <article class="article-card">
                  <h3 class="article-title">
                    <a href={`/ai-learning-blog/${post.collection}/${post.slug}`}>
                      {post.data.title}
                    </a>
                  </h3>

                  <div class="article-meta">
                    <span>📅 {post.data.date.toLocaleDateString('zh-CN')}</span>
                    {post.data.category && <span>📁 {post.data.category}</span>}
                  </div>

                  {post.data.description && (
                    <p class="article-excerpt">{post.data.description}</p>
                  )}

                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="tags">
                      {post.data.tags.map((tag: string) => (
                        <a href={`/ai-learning-blog/tags/${tag}`} class="tag">#{tag}</a>
                      ))}
                    </div>
                  )}
                </article>
              ))}
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- 侧边栏 -->
    <aside>
      <div class="sidebar">
        <h3>📚 学习系列</h3>
        <ul>
          <li><a href="/ai-learning-blog/">全部文章</a></li>
          {activeCollections.map(([key, meta]) => (
            <li>
              <a href={`/ai-learning-blog/#${key}`}>
                {meta.icon} {meta.name}
                <span style="color: var(--text-secondary); font-size: 0.85rem;"> ({meta.posts.length})</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="sidebar">
        <h3>🏷️ 热门标签</h3>
        <div class="tags" style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
          {Array.from(allTags).slice(0, 15).map(tag => (
            <a href={`/ai-learning-blog/tags/${tag}`} class="tag">#{tag}</a>
          ))}
        </div>
      </div>

      <div class="sidebar">
        <h3>📊 统计</h3>
        <ul>
          <li>📝 文章总数: {totalPosts}</li>
          <li>🏷️ 标签数量: {allTags.size}</li>
          <li>📂 系列数量: {activeCollections.length}</li>
        </ul>
      </div>
    </aside>
  </div>
</Layout>
