      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .pagination {
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .page-btn {
      padding: 0.625rem 1rem;
      font-size: 0.8125rem;
    }

    .page-num {
      width: 2.25rem;
      height: 2.25rem;
      font-size: 0.8125rem;
    }
