    background: linear-gradient(135deg, #f8fffe 0%, #ffffff 100%);
    padding: 4rem 2rem;
    text-align: center;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .hero-title {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: 3.5rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -1.28px;
    color: #0d0d0d;
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.5;
    color: #666666;
    margin-bottom: 2rem;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .stat-badge {
    background: #d4fae8;
    color: #0fa76e;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
  }

  /* ==================== Category Filter ==================== */
  .category-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: #333333;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    background: #f5f5f5;
    border-color: rgba(0, 0, 0, 0.12);
  }

  .filter-btn.active {
    background: #18E299;
    color: #0d0d0d;
    border-color: #18E299;
  }

