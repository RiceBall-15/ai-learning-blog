---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categoryMeta } from '../content/config';

// 动态获取所有分类的文章
const collectionData: Record<string, { name: string; icon: string; description: string; posts: any[] }> = {};

for (const [key, meta] of Object.entries(categoryMeta)) {
  const posts = (await getCollection(key as any))
    .filter((post: any) => !post.data.draft)
    .sort((a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf());
  
  collectionData[key] = {
    ...meta,
    posts,
  };
}

// 合并所有文章并按日期排序
const allPosts = Object.values(collectionData)
  .flatMap(c => c.posts)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 获取所有标签
const allTags = new Set<string>();
allPosts.forEach(post => {
  post.data.tags.forEach((tag: string) => allTags.add(tag));
});

const totalPosts = allPosts.length;
const activeCollections = Object.entries(collectionData).filter(([_, c]) => c.posts.length > 0);

// 准备JSON数据供JavaScript使用
const postsData = allPosts.map(post => ({
  slug: post.slug,
  collection: post.collection,
  title: post.data.title,
  description: post.data.description || '',
  date: post.data.date.toISOString(),
  tags: post.data.tags || [],
  category: post.data.category || '',
}));

const categoriesData = Object.fromEntries(
  activeCollections.map(([key, meta]) => [
    key, 
    { 
      name: meta.name, 
      icon: meta.icon, 
      count: meta.posts.length,
      posts: meta.posts.map(p => p.slug)
    }
  ])
);
---

<Layout title="首页 - AI 深度学习笔记">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <h1 class="hero-title">AI 深度学习笔记</h1>
      <p class="hero-subtitle">深入探索大语言模型、框架应用和训练技术的学习之路</p>
      <div class="hero-stats">
        <span class="stat-badge">{totalPosts} 篇文章</span>
        <span class="stat-badge">{activeCollections.length} 个系列</span>
        <span class="stat-badge">{allTags.size} 个标签</span>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <main class="main-content">
    <!-- Category Filter -->
    <div class="category-filter" id="categoryFilter">
      <button class="filter-btn active" data-category="all">
        全部
      </button>
      {activeCollections.map(([key, meta]) => (
        <button class="filter-btn" data-category={key}>
          <span class="filter-icon">{meta.icon}</span>
          {meta.name}
          <span class="filter-count">{meta.posts.length}</span>
        </button>
      ))}
    </div>

    <div class="content-grid">
      <!-- Articles Section -->
      <section class="articles-section">
        <div class="articles-header">
          <h2 class="section-title" id="sectionTitle">📚 最新文章</h2>
          <span class="posts-count" id="postsCount">
            共 {totalPosts} 篇，第 1/{Math.ceil(totalPosts / 12)} 页
          </span>
        </div>

        <div class="articles-grid" id="articlesGrid">
          {allPosts.slice(0, 12).map((post) => (
            <article class="article-card" data-slug={post.slug}>
              <a href={`/ai-learning-blog/${post.collection}/${post.slug}`} class="article-link">
                <div class="article-meta">
                  <time class="article-date">{post.data.date.toLocaleDateString('zh-CN')}</time>
                  {post.data.category && <span class="article-category">{post.data.category}</span>}
                </div>
                <h3 class="article-title">{post.data.title}</h3>
                {post.data.description && (
                  <p class="article-excerpt">{post.data.description}</p>
                )}
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="article-tags">
                    {post.data.tags.slice(0, 3).map((tag: string) => (
                      <span class="tag">#{tag}</span>
                    ))}
                  </div>
                )}
              </a>
            </article>
          ))}
        </div>

        <!-- Pagination -->
        <nav class="pagination" id="pagination">
          <button class="page-btn prev disabled" id="prevBtn">← 上一页</button>
          <div class="page-numbers" id="pageNumbers"></div>
          <button class="page-btn next" id="nextBtn">下一页 →</button>
        </nav>
      </section>

      <!-- Sidebar -->
      <aside class="sidebar">
        <div class="sidebar-card">
          <h3 class="sidebar-title">分类导航</h3>
          <nav class="category-nav">
            {activeCollections.map(([key, meta]) => (
              <a href={`#`} class="nav-item sidebar-category" data-category={key}>
                <span class="nav-icon">{meta.icon}</span>
                <span class="nav-text">{meta.name}</span>
                <span class="nav-count">{meta.posts.length}</span>
              </a>
            ))}
          </nav>
        </div>

        <div class="sidebar-card">
          <h3 class="sidebar-title">热门标签</h3>
          <div class="tags-cloud">
            {Array.from(allTags).slice(0, 12).map(tag => (
              <a href={`/ai-learning-blog/tags/${tag}`} class="tag-pill">#{tag}</a>
            ))}
          </div>
        </div>

        <div class="sidebar-card">
          <h3 class="sidebar-title">关于</h3>
          <p class="about-text">
            这是我的AI技术学习笔记，记录大语言模型、Agent系统、推理框架等前沿技术的深度研究和实践经验。
          </p>
        </div>
      </aside>
    </div>
  </main>
</Layout>

<!-- 客户端分页和筛选脚本 -->
<script define:vars={{ postsData, categoriesData }}>
// 分页状态
const POSTS_PER_PAGE = 12;
let currentPage = 1;
let currentCategory = 'all';
let filteredPosts = [...postsData];

// DOM元素
const articlesGrid = document.getElementById('articlesGrid');
const pagination = document.getElementById('pagination');
const pageNumbers = document.getElementById('pageNumbers');
const prevBtn = document.getElementById('prevBtn');
const nextBtn = document.getElementById('nextBtn');
const sectionTitle = document.getElementById('sectionTitle');
const postsCount = document.getElementById('postsCount');

// 渲染文章
function renderArticles() {
  const start = (currentPage - 1) * POSTS_PER_PAGE;
  const end = start + POSTS_PER_PAGE;
  const pagePosts = filteredPosts.slice(start, end);
  
  articlesGrid.innerHTML = pagePosts.map(post => `
    <article class="article-card" data-slug="${post.slug}">
      <a href="/ai-learning-blog/${post.collection}/${post.slug}" class="article-link">
        <div class="article-meta">
          <time class="article-date">${new Date(post.date).toLocaleDateString('zh-CN')}</time>
          ${post.category ? `<span class="article-category">${post.category}</span>` : ''}
        </div>
        <h3 class="article-title">${post.title}</h3>
        ${post.description ? `<p class="article-excerpt">${post.description}</p>` : ''}
        ${post.tags && post.tags.length > 0 ? `
          <div class="article-tags">
            ${post.tags.slice(0, 3).map(tag => `<span class="tag">#${tag}</span>`).join('')}
          </div>
        ` : ''}
      </a>
    </article>
  `).join('');
}

// 渲染分页
function renderPagination() {
  const totalPages = Math.ceil(filteredPosts.length / POSTS_PER_PAGE);
  
  // 更新页码显示
  pageNumbers.innerHTML = '';
  for (let i = 1; i <= totalPages; i++) {
    const pageBtn = document.createElement('button');
    pageBtn.className = `page-num ${i === currentPage ? 'active' : ''}`;
    pageBtn.textContent = i;
    pageBtn.addEventListener('click', () => goToPage(i));
    pageNumbers.appendChild(pageBtn);
  }
  
  // 更新上一页/下一页按钮状态
  prevBtn.classList.toggle('disabled', currentPage <= 1);
  nextBtn.classList.toggle('disabled', currentPage >= totalPages);
}

// 更新计数显示
function updateCounts() {
  const totalPages = Math.ceil(filteredPosts.length / POSTS_PER_PAGE);
  const categoryInfo = currentCategory === 'all' 
    ? { name: '📚 最新文章', icon: '' }
    : categoriesData[currentCategory];
  
  sectionTitle.textContent = categoryInfo.name;
  postsCount.textContent = `共 ${filteredPosts.length} 篇，第 ${currentPage}/${totalPages} 页`;
}

// 跳转到指定页
function goToPage(page) {
  const totalPages = Math.ceil(filteredPosts.length / POSTS_PER_PAGE);
  if (page < 1 || page > totalPages) return;
  
  currentPage = page;
  renderArticles();
  renderPagination();
  updateCounts();
  
  // 滚动到文章区域顶部
  document.querySelector('.articles-section').scrollIntoView({ behavior: 'smooth' });
}

// 筛选分类
function filterByCategory(category) {
  currentCategory = category;
  currentPage = 1;
  
  if (category === 'all') {
    filteredPosts = [...postsData];
  } else {
    const categoryPostSlugs = categoriesData[category]?.posts || [];
    filteredPosts = postsData.filter(p => categoryPostSlugs.includes(p.slug));
  }
  
  // 更新筛选按钮状态
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.category === category);
  });
  
  renderArticles();
  renderPagination();
  updateCounts();
}

// 初始化事件监听
document.getElementById('categoryFilter').addEventListener('click', (e) => {
  const btn = e.target.closest('.filter-btn');
  if (btn) {
    filterByCategory(btn.dataset.category);
  }
});

document.querySelectorAll('.sidebar-category').forEach(link => {
  link.addEventListener('click', (e) => {
    e.preventDefault();
    filterByCategory(link.dataset.category);
  });
});

prevBtn.addEventListener('click', () => goToPage(currentPage - 1));
nextBtn.addEventListener('click', () => goToPage(currentPage + 1));

// 初始化
renderPagination();
updateCounts();
</script>

<style is:global>
  /* ==================== Hero Section ==================== */
