---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categoryMeta, subCategories, legacySubCategoryMap, seriesMeta, tagSlug } from '../content/config';

// 动态获取所有分类的文章
const collectionData: Record<string, { name: string; icon: string; description: string; posts: any[] }> = {};

for (const [key, meta] of Object.entries(categoryMeta)) {
  const posts = (await getCollection(key as any))
    .filter((post: any) => !post.data.draft)
    .sort((a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf());
  
  collectionData[key] = {
    ...meta,
    posts,
  };
}

// 合并所有文章并按日期排序
const allPosts = Object.values(collectionData)
  .flatMap(c => c.posts)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 获取所有标签
const allTags = new Set<string>();
allPosts.forEach(post => {
  post.data.tags.forEach((tag: string) => allTags.add(tag));
});

const totalPosts = allPosts.length;
const activeCollections = Object.entries(collectionData).filter(([_, c]) => c.posts.length > 0);

// 全部系列（供侧栏用）。系列与分类是两个维度：
// 分类回答「属于哪个领域」，系列回答「按什么顺序读完能形成完整认知」，
// 所以侧栏列系列，不再重复一遍上方的分类筛选。
const allSeries = Object.entries(seriesMeta).map(([id, meta]) => {
  const posts = (collectionData[meta.collection]?.posts ?? []).filter(
    (p: any) => p.data.series === id
  );
  return { id, meta, count: posts.length };
}).filter((s) => s.count > 0);

// 报头要推荐的成套阅读：取第一个系列，按序号列出
const featuredSeriesId = Object.keys(seriesMeta)[0];
const featuredSeries = featuredSeriesId ? seriesMeta[featuredSeriesId] : null;
const featuredSeriesPosts = featuredSeries
  ? (collectionData[featuredSeries.collection]?.posts ?? [])
      .filter((p: any) => p.data.series === featuredSeriesId)
      .sort((a: any, b: any) => (a.data.seriesOrder ?? 999) - (b.data.seriesOrder ?? 999))
  : [];

// 准备JSON数据供JavaScript使用
const postsData = allPosts.map(post => ({
  slug: post.slug,
  collection: post.collection,
  title: post.data.title,
  description: post.data.description || '',
  date: post.data.date.toISOString(),
  tags: post.data.tags || [],
  category: post.data.category || '',
  subCategory: post.data.subCategory || legacySubCategoryMap[post.data.category] || '',
}));

const categoriesData = Object.fromEntries(
  activeCollections.map(([key, meta]) => [
    key, 
    { 
      name: meta.name, 
      icon: meta.icon, 
      count: meta.posts.length,
      subCategories: subCategories[key] || [],
      posts: meta.posts.map(p => ({
        slug: p.slug,
        subCategory: p.data.subCategory || legacySubCategoryMap[p.data.category] || '',
      }))
    }
  ])
);

// 构建子分类文章映射
const subCategoryPosts: Record<string, { name: string; icon: string; posts: any[] }> = {};
for (const [catKey, catMeta] of Object.entries(categoriesData)) {
  const subs = catMeta.subCategories;
  for (const sub of subs) {
    const posts = catMeta.posts.filter(p => p.subCategory === sub.id);
    if (posts.length > 0) {
      subCategoryPosts[sub.id] = {
        name: sub.name,
        icon: sub.icon,
        posts,
        parent: catKey,
      };
    }
  }
}

// 打印调试信息
console.log('SubCategories defined:', Object.keys(subCategories));
console.log('SubCategoryPosts found:', Object.keys(subCategoryPosts));
---

<Layout title="AI 深度学习笔记">
  <!-- 返回顶部按钮 -->
  <button class="back-to-top" id="backToTop" title="返回顶部">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M18 15l-6-6-6 6"/>
    </svg>
  </button>
  
  <!-- ══ 报头 ══
       原先是渐变 + 假代码窗 + 三个大数字。那套写法哪个博客都能套，
       且滚过整屏才见到内容。改成手册式报头：一句真正的论点，
       紧跟成套阅读入口与领域索引——读者第一屏就能决定去哪。 -->
  <section class="masthead">
    <div class="mh-inner">
      <div class="mh-lead">
        <p class="mh-eyebrow">技术笔记 · 持续更新</p>
        <h1 class="mh-title">
          把 Agent 拆到<br />
          <span class="mh-em">能讲清每一处机制</span>
        </h1>
        <p class="mh-thesis">
          编排怎么保证跑得对、工具怎么保证不双花、记忆怎么保证不越记越乱、
          成本怎么算得住、质量怎么证明真的变好了——这里记录的是这些问题的具体答案，
          不是概念综述。
        </p>
        <dl class="mh-facts">
          <div>
            <dt>笔记</dt>
            <dd>{totalPosts} 篇</dd>
          </div>
          <div>
            <dt>领域</dt>
            <dd>{activeCollections.length} 个</dd>
          </div>
          <div>
            <dt>标签</dt>
            <dd>{allTags.size} 个</dd>
          </div>
        </dl>
      </div>

      {featuredSeries && featuredSeriesPosts.length > 0 && (
        <aside class="mh-series">
          <div class="mhs-head">
            <span class="mhs-label">成套阅读</span>
            <a class="mhs-name" href={`/ai-learning-blog/series/${featuredSeriesId}`}>
              {featuredSeries.name}
            </a>
            <span class="mhs-count">{featuredSeriesPosts.length} 篇 · 建议按顺序</span>
          </div>
          <ol class="mhs-list">
            {featuredSeriesPosts.map((p: any) => (
              <li>
                <a href={`/ai-learning-blog/${featuredSeries.collection}/${p.slug}`}>
                  <span class="mhs-no">{String(p.data.seriesOrder).padStart(2, '0')}</span>
                  <span class="mhs-t">{p.data.title.replace(/^Agent 面试深挖（[^）]+）：/, '')}</span>
                </a>
              </li>
            ))}
          </ol>
        </aside>
      )}
    </div>
  </section>

  <!-- Main Content - 两列布局 -->
  <main class="main-content">
    <div class="main-container">
      <!-- 左侧：文章列表 -->
      <section class="articles-section">
        <div class="section-header">
          <h2 class="section-title">
                        <span id="sectionTitle">最新文章</span>
            <span class="article-count" id="articleCount">({totalPosts}篇)</span>
          </h2>
          <!-- 视图切换 -->
          <div class="view-toggle">
            <button class="view-btn active" data-view="list" title="列表视图">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                <path d="M2 3h12v1H2V3zm0 4h12v1H2V7zm0 4h12v1H2v-1z"/>
              </svg>
            </button>
            <button class="view-btn" data-view="grouped" title="分组视图">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                <path d="M1 2h6v6H1V2zm8 0h6v6H9V2zM1 10h6v4H1v-4zm8 0h6v4H9v-4z"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- 搜索框 -->
        <div class="search-container">
          <div class="search-box">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input type="text" class="search-input" id="searchInput" placeholder="搜索文章... (Ctrl+K)" />
            <button class="search-clear" id="searchClear" style="display: none;">×</button>
          </div>
          <span class="search-count" id="searchCount"></span>
        </div>

        <!-- 分类筛选标签 -->
        <div class="filter-tabs" id="filterTabs">
          <button class="filter-tab active" data-category="all">全部</button>
          {activeCollections.map(([key, meta]) => (
            <button class="filter-tab" data-category={key}>
              <span class="tab-icon">{meta.icon}</span>
              <span class="tab-text">{meta.name}</span>
              <span class="tab-count">{meta.posts.length}</span>
            </button>
          ))}
        </div>

        <!-- 文章列表视图 -->
        <div class="articles-list" id="articlesList">
          {allPosts.slice(0, 12).map((post, index) => (
            <article class="article-item" style={`--delay: ${index * 0.05}s`}>
              <a href={`/ai-learning-blog/${post.collection}/${post.slug}`} class="article-link">
                <div class="article-meta">
                  <time class="article-date">
                    {post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
                  </time>
                  {post.data.category && (
                    <span class="article-category">{post.data.category}</span>
                  )}
                </div>
                <h3 class="article-title">{post.data.title}</h3>
                {post.data.description && (
                  <p class="article-excerpt">{post.data.description.substring(0, 100)}...</p>
                )}
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="article-tags">
                    {post.data.tags.slice(0, 3).map((tag: string) => (
                      <span class="tag">#{tag}</span>
                    ))}
                  </div>
                )}
              </a>
            </article>
          ))}
        </div>

        <!-- 分组视图 -->
        <div class="grouped-view" id="groupedView" style="display: none;">
          {activeCollections.map(([catKey, catMeta]) => (
            <div class="category-group" data-category={catKey}>
              <div class="group-header" data-toggle={catKey}>
                <span class="group-icon">{catMeta.icon}</span>
                <span class="group-name">{catMeta.name}</span>
                <span class="group-count">{catMeta.posts.length}篇</span>
                <span class="group-arrow">▼</span>
              </div>
              <div class="group-content" id={`group-${catKey}`}>
                {/* 显示子分类 */}
                {(subCategories[catKey] || []).map(sub => {
                  const subPosts = allPosts.filter(p => {
                    const postSubCat = p.data.subCategory || legacySubCategoryMap[p.data.category] || '';
                    return p.collection === catKey && postSubCat === sub.id;
                  });
                  if (subPosts.length === 0) return null;
                  return (
                    <div class="subcategory-group">
                      <div class="subcategory-header" data-toggle={`sub-${sub.id}`}>
                        <span class="subcategory-icon">{sub.icon}</span>
                        <span class="subcategory-name">{sub.name}</span>
                        <span class="subcategory-count">{subPosts.length}</span>
                        <span class="subcategory-arrow">›</span>
                      </div>
                      <div class="subcategory-content" id={`sub-${sub.id}`}>
                        {subPosts.slice(0, 5).map(post => (
                          <a href={`/ai-learning-blog/${post.collection}/${post.slug}`} class="grouped-article-link">
                            <span class="article-dot">•</span>
                            <span class="article-title-text">{post.data.title}</span>
                            <span class="article-date-small">
                              {post.data.date.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })}
                            </span>
                          </a>
                        ))}
                        {subPosts.length > 5 && (
                          <div class="show-more" data-category={catKey} data-subcategory={sub.id}>
                            查看全部 {subPosts.length} 篇 →
                          </div>
                        )}
                      </div>
                    </div>
                  );
                })}
                {/* 显示未分类的文章 */}
                {(() => {
                  const uncategorized = allPosts.filter(p => {
                    const postSubCat = p.data.subCategory || legacySubCategoryMap[p.data.category] || '';
                    return p.collection === catKey && !postSubCat;
                  });
                  if (uncategorized.length === 0) return null;
                  return (
                    <div class="subcategory-group">
                      <div class="subcategory-header" data-toggle={`sub-uncategorized-${catKey}`}>
                                                <span class="subcategory-name">其他</span>
                        <span class="subcategory-count">{uncategorized.length}</span>
                        <span class="subcategory-arrow">›</span>
                      </div>
                      <div class="subcategory-content" id={`sub-uncategorized-${catKey}`}>
                        {uncategorized.slice(0, 5).map(post => (
                          <a href={`/ai-learning-blog/${post.collection}/${post.slug}`} class="grouped-article-link">
                            <span class="article-dot">•</span>
                            <span class="article-title-text">{post.data.title}</span>
                            <span class="article-date-small">
                              {post.data.date.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })}
                            </span>
                          </a>
                        ))}
                        {uncategorized.length > 5 && (
                          <div class="show-more" data-category={catKey}>
                            查看全部 {uncategorized.length} 篇 →
                          </div>
                        )}
                      </div>
                    </div>
                  );
                })()}
              </div>
            </div>
          ))}
        </div>

        <!-- 分页 -->
        <nav class="pagination" id="pagination">
          <div class="page-info">
            <span id="pageInfo">第 1 页 / 共 1 页，共 {totalPosts} 篇</span>
          </div>
          <div class="page-controls">
            <button class="page-btn prev disabled" id="prevBtn">上一页</button>
            <div class="page-numbers" id="pageNumbers"></div>
            <button class="page-btn next" id="nextBtn">下一页</button>
          </div>
        </nav>
      </section>

      <!-- 右侧：侧边栏 -->
      <aside class="sidebar">
        <!-- 成套系列：与上方分类筛选是两个维度，不重复 -->
        <div class="sidebar-card">
          <h3 class="sidebar-title"><span>成套系列</span></h3>
          <p class="sidebar-note">按顺序读完能形成完整认知的成套文章。</p>
          <nav class="series-nav-list">
            {allSeries.map((s) => (
              <a href={`/ai-learning-blog/series/${s.id}`} class="snl-item">
                <span class="snl-code">{s.meta.icon}</span>
                <span class="snl-body">
                  <span class="snl-name">{s.meta.name}</span>
                  <span class="snl-count">{s.count} 篇</span>
                </span>
              </a>
            ))}
          </nav>
        </div>

        <!-- 热门标签 -->
        <div class="sidebar-card">
          <h3 class="sidebar-title">
                        <span>热门标签</span>
          </h3>
          <div class="tags-cloud">
            {Array.from(allTags).slice(0, 20).map(tag => (
              <a href={`/ai-learning-blog/tags/${tagSlug(tag)}`} class="tag-item">
                #{tag}
              </a>
            ))}
          </div>
        </div>

      </aside>
    </div>
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-content">
      <div class="footer-brand">
                <span class="brand-text">AI 深度学习笔记</span>
      </div>
      <p class="footer-description">记录AI技术学习之路，分享深度研究心得</p>
      <div class="footer-links">
        <a href="https://github.com/RiceBall-15" target="_blank" rel="noopener">GitHub</a>
        <a href="https://github.com/RiceBall-15/ai-learning-blog" target="_blank" rel="noopener">博客源码</a>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* 本页只补两个 global.css 里没有的别名；
     配色、圆角、阴影一律继承设计令牌——原先这里重定义了一整套 indigo 变量，
     会把全站配色在首页覆盖掉，是主题不统一的根因。 */
  :root {
    --color-text: var(--color-text-primary);
    --color-bg-secondary: var(--paper-sunken);
    --transition: all var(--transition-base);
  }

  /* ==================== Hero Banner ==================== */
  /* 分类代号：两个字母的等宽标签，替代原先的 emoji 图标。
     与文章页规格轨、报头统一成一套「仪表标签」语言。 */
  .tab-icon,
  .tree-icon {
    display: inline-grid;
    place-items: center;
    min-width: 1.6rem;
    padding: 0.05rem 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.5;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
  }
  .filter-tab.active .tab-icon {
    color: var(--signal);
    border-color: color-mix(in srgb, var(--signal) 45%, transparent);
  }

  /* ==================== 侧栏：成套系列 ==================== */
  .sidebar-note {
    margin: 0 0 0.85rem;
    font-size: 0.82rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .series-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .snl-item {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    padding: 0.55rem 0.6rem;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }
  .snl-item:hover {
    background: var(--signal-soft);
    border-color: color-mix(in srgb, var(--signal) 30%, transparent);
  }
  .snl-code {
    flex: none;
    margin-top: 0.1rem;
    min-width: 1.6rem;
    padding: 0.05rem 0.25rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  .snl-item:hover .snl-code {
    color: var(--signal);
    border-color: color-mix(in srgb, var(--signal) 45%, transparent);
  }
  .snl-body { min-width: 0; }
  .snl-name {
    display: block;
    font-size: 0.86rem;
    font-weight: 500;
    line-height: 1.45;
    color: var(--color-text-primary);
  }
  .snl-count {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  /* ==================== 报头 Masthead ==================== */
  .masthead {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .mh-inner {
    max-width: 70rem;
    margin: 0 auto;
    padding: 4rem 2rem 3.25rem;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 4rem;
    align-items: start;
  }

  .mh-eyebrow {
    margin: 0 0 1.1rem;
    font-family: var(--font-label);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .mh-title {
    margin: 0;
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.1rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.015em;
    color: var(--color-text-primary);
  }

  /* 第二行压在一条信号色底线上：报头唯一的装饰，其余保持安静 */
  .mh-em {
    display: inline-block;
    padding-bottom: 0.1em;
    border-bottom: 3px solid var(--signal);
  }

  .mh-thesis {
    margin: 1.5rem 0 0;
    max-width: 34em;
    font-size: 1rem;
    line-height: 1.85;
    color: var(--color-text-secondary);
  }

  .mh-facts {
    display: flex;
    gap: 2.5rem;
    margin: 2rem 0 0;
  }
  .mh-facts dt {
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .mh-facts dd {
    margin: 0.25rem 0 0;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-text-primary);
  }

  /* ── 成套阅读：报头右侧直接给出目录，不用再翻一层 ── */
  .mh-series {
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--signal);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
  }

  .mhs-head {
    padding: 1rem 1.1rem 0.9rem;
    border-bottom: 1px solid var(--color-border);
  }
  .mhs-label {
    display: block;
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal);
  }
  .mhs-name {
    display: block;
    margin-top: 0.3rem;
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-text-primary);
    transition: color var(--transition-fast);
  }
  .mhs-name:hover { color: var(--signal); }
  .mhs-count {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--color-text-muted);
  }

  .mhs-list {
    list-style: none;
    margin: 0;
    padding: 0.35rem 0;
    max-height: 19rem;
    overflow-y: auto;
  }
  .mhs-list a {
    display: flex;
    gap: 0.75rem;
    padding: 0.4rem 1.1rem;
    align-items: baseline;
    transition: background var(--transition-fast);
  }
  .mhs-list a:hover { background: var(--signal-soft); }
  .mhs-no {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--color-text-muted);
  }
  .mhs-list a:hover .mhs-no { color: var(--signal); }
  .mhs-t {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }
  .mhs-list a:hover .mhs-t { color: var(--color-text-primary); }

  @media (max-width: 900px) {
    .mh-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
