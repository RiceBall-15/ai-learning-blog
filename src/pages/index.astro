<script define:vars={{ postsData, categoriesData }}>
// (打字机效果已随报头改版移除)

// 分页状态
const POSTS_PER_PAGE = 12;
let currentPage = 1;
let currentCategory = 'all';
let currentSubCategory = '';
let filteredPosts = [...postsData];
let searchQuery = '';
let currentView = 'list';

// DOM元素
const articlesList = document.getElementById('articlesList');
const groupedView = document.getElementById('groupedView');
const pageNumbers = document.getElementById('pageNumbers');
const prevBtn = document.getElementById('prevBtn');
const nextBtn = document.getElementById('nextBtn');
const sectionTitle = document.getElementById('sectionTitle');
const searchInput = document.getElementById('searchInput');
const searchClear = document.getElementById('searchClear');
const searchCount = document.getElementById('searchCount');
const articleCount = document.getElementById('articleCount');

// 获取过滤后的文章
function getFilteredPosts() {
  let posts = currentCategory === 'all' 
    ? [...postsData] 
    : postsData.filter(p => p.collection === currentCategory);
  
  // 应用子分类过滤
  if (currentSubCategory) {
    posts = posts.filter(p => p.subCategory === currentSubCategory);
  }
  
  if (searchQuery) {
    const query = searchQuery.toLowerCase();
    posts = posts.filter(p => 
      p.title.toLowerCase().includes(query) || 
      p.description.toLowerCase().includes(query) || 
      p.tags.some(t => t.toLowerCase().includes(query))
    );
  }
  
  return posts;
}

// 渲染文章
function renderArticles() {
  filteredPosts = getFilteredPosts();
  const totalPages = Math.ceil(filteredPosts.length / POSTS_PER_PAGE);
  currentPage = Math.min(currentPage, totalPages || 1);
  
  const start = (currentPage - 1) * POSTS_PER_PAGE;
  const end = start + POSTS_PER_PAGE;
  const pagePosts = filteredPosts.slice(start, end);
  
  articlesList.innerHTML = pagePosts.map((post, index) => `
    <article class="article-item" style="--delay: ${index * 0.05}s">
      <a href="/ai-learning-blog/${post.collection}/${post.slug}" class="article-link">
        <div class="article-meta">
          <time class="article-date">
            ${new Date(post.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}
          </time>
          ${post.category ? `<span class="article-category">${post.category}</span>` : ''}
        </div>
        <h3 class="article-title">${post.title}</h3>
        ${post.description ? `<p class="article-excerpt">${post.description.substring(0, 120)}${post.description.length > 120 ? '...' : ''}</p>` : ''}
        ${post.tags && post.tags.length > 0 ? `
          <div class="article-tags">
            ${post.tags.slice(0, 3).map(tag => `<span class="tag">#${tag}</span>`).join('')}
          </div>
        ` : ''}
      </a>
    </article>
  `).join('');
  
  // 更新搜索结果计数
  if (searchQuery) {
    searchCount.textContent = `找到 ${filteredPosts.length} 篇文章`;
  } else {
    searchCount.textContent = '';
  }
  
  // 更新文章总数显示
  articleCount.textContent = `(${filteredPosts.length}篇)`;
}

// 渲染分页
function renderPagination() {
  const totalPages = Math.ceil(filteredPosts.length / POSTS_PER_PAGE);
  
  // 更新分页信息
  const pageInfo = document.getElementById('pageInfo');
  if (pageInfo) {
    pageInfo.textContent = `第 ${currentPage} 页 / 共 ${totalPages} 页，共 ${filteredPosts.length} 篇`;
  }
  
  pageNumbers.innerHTML = '';
  
  if (totalPages <= 7) {
    for (let i = 1; i <= totalPages; i++) {
      const pageBtn = document.createElement('button');
      pageBtn.className = `page-num ${i === currentPage ? 'active' : ''}`;
      pageBtn.textContent = i;
      pageBtn.addEventListener('click', () => goToPage(i));
      pageNumbers.appendChild(pageBtn);
    }
  } else {
    const pages = new Set([1, totalPages]);
    for (let i = Math.max(2, currentPage - 1); i <= Math.min(totalPages - 1, currentPage + 1); i++) {
      pages.add(i);
    }
    
    const sortedPages = Array.from(pages).sort((a, b) => a - b);
    let lastPage = 0;
    
    sortedPages.forEach(page => {
      if (page - lastPage > 1) {
        const ellipsis = document.createElement('span');
        ellipsis.className = 'page-ellipsis';
        ellipsis.textContent = '...';
        pageNumbers.appendChild(ellipsis);
      }
      
      const pageBtn = document.createElement('button');
      pageBtn.className = `page-num ${page === currentPage ? 'active' : ''}`;
      pageBtn.textContent = page;
      pageBtn.addEventListener('click', () => goToPage(page));
      pageNumbers.appendChild(pageBtn);
      
      lastPage = page;
    });
  }
  
  prevBtn.classList.toggle('disabled', currentPage <= 1);
  nextBtn.classList.toggle('disabled', currentPage >= totalPages);
}

// 更新标题
function updateTitle() {
  let title = '最新文章';
  if (currentCategory !== 'all') {
    const categoryInfo = categoriesData[currentCategory];
    title = categoryInfo.name;
    if (currentSubCategory) {
      const subCat = categoryInfo.subCategories?.find(s => s.id === currentSubCategory);
      if (subCat) {
        title = `${categoryInfo.name} / ${subCat.name}`;
      }
    }
  }
  sectionTitle.textContent = title;
}

// 跳转到指定页
function goToPage(page) {
  const totalPages = Math.ceil(filteredPosts.length / POSTS_PER_PAGE);
  if (page < 1 || page > totalPages) return;
  
  currentPage = page;
  renderArticles();
  renderPagination();
  
  document.querySelector('.articles-section').scrollIntoView({ behavior: 'smooth' });
}

// 筛选分类
function filterByCategory(category, subCategory = '') {
  currentCategory = category;
  currentSubCategory = subCategory;
  currentPage = 1;
  
  // 更新筛选按钮状态
  document.querySelectorAll('.filter-tab').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.category === category);
  });
  
  renderArticles();
  renderPagination();
  updateTitle();
}

// 搜索功能
function handleSearch(query) {
  searchQuery = query.trim();
  currentPage = 1;
  searchClear.style.display = searchQuery ? 'block' : 'none';
  renderArticles();
  renderPagination();
  updateTitle();
}

// 清除搜索
function clearSearch() {
  searchInput.value = '';
  searchQuery = '';
  searchClear.style.display = 'none';
  currentPage = 1;
  renderArticles();
  renderPagination();
  updateTitle();
}

// 视图切换
function switchView(view) {
  currentView = view;
  
  document.querySelectorAll('.view-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.view === view);
  });
  
  if (view === 'list') {
    articlesList.style.display = 'flex';
    groupedView.style.display = 'none';
    document.getElementById('pagination').style.display = 'flex';
  } else {
    articlesList.style.display = 'none';
    groupedView.style.display = 'flex';
    document.getElementById('pagination').style.display = 'none';
  }
}

// 初始化事件监听
document.getElementById('filterTabs').addEventListener('click', (e) => {
  const btn = e.target.closest('.filter-tab');
  if (btn) {
    filterByCategory(btn.dataset.category);
  }
});

// 分组视图展开/折叠
document.querySelectorAll('.group-header').forEach(header => {
  header.addEventListener('click', () => {
    const group = header.closest('.category-group');
    group.classList.toggle('expanded');
  });
});

document.querySelectorAll('.subcategory-header').forEach(header => {
  header.addEventListener('click', () => {
    const subGroup = header.closest('.subcategory-group');
    subGroup.classList.toggle('expanded');
  });
});

// 显示全部按钮
document.querySelectorAll('.show-more').forEach(btn => {
  btn.addEventListener('click', () => {
    const category = btn.dataset.category;
    const subCategory = btn.dataset.subcategory;
    filterByCategory(category, subCategory);
    switchView('list');
  });
});

// 视图切换按钮
document.querySelectorAll('.view-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    switchView(btn.dataset.view);
  });
});

prevBtn.addEventListener('click', () => goToPage(currentPage - 1));
nextBtn.addEventListener('click', () => goToPage(currentPage + 1));

// 搜索事件
let searchTimeout;
searchInput.addEventListener('input', (e) => {
  clearTimeout(searchTimeout);
  searchTimeout = setTimeout(() => handleSearch(e.target.value), 300);
});

searchClear.addEventListener('click', clearSearch);

// 键盘快捷键
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && searchQuery) {
    clearSearch();
  }
  if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
    e.preventDefault();
    searchInput.focus();
  }
});

// 初始化
renderArticles();
renderPagination();
updateTitle();

// 返回顶部按钮
const backToTopBtn = document.getElementById('backToTop');
if (backToTopBtn) {
  window.addEventListener('scroll', () => {
    if (window.scrollY > 400) {
      backToTopBtn.classList.add('visible');
    } else {
      backToTopBtn.classList.remove('visible');
    }
  });
  
  backToTopBtn.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
}
</script>
