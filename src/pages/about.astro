---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categoryMeta } from '../content/config';

let total = 0;
const counts: { name: string; n: number }[] = [];
for (const [key, meta] of Object.entries(categoryMeta)) {
  const posts = (await getCollection(key as any)).filter((p: any) => !p.data.draft);
  total += posts.length;
  counts.push({ name: meta.name, n: posts.length });
}
counts.sort((a, b) => b.n - a.n);
---

<Layout title="关于" description="关于这个博客与作者">
  <main class="about">
    <header class="ab-head">
      <p class="ab-eyebrow">关于</p>
      <h1>这个博客记录什么</h1>
      <p class="ab-lead">
        主要是 AI Agent 的工程实现——不是「Agent 是什么」，而是「做出来会遇到什么，
        以及具体怎么解」。多数篇目围绕几个反复出现的难题：编排怎么保证跑得对、
        工具调用怎么保证不重复执行、长期记忆怎么保证不越记越乱、
        推理成本怎么算得住、质量改动怎么证明真的有效。
      </p>
    </header>

    <section class="ab-sec">
      <h2>写法</h2>
      <ul class="ab-list">
        <li>尽量写到机制层：给伪码、状态机与不变式，而不是停在名词。</li>
        <li>记录踩过的坑：现象 → 排查 → 修复 → 怎么验证，方便日后复查。</li>
        <li>讲清取舍：为什么这么选，以及什么场景下不该这么选。</li>
        <li>不编数字：没有可靠度量时只说趋势和量级。</li>
      </ul>
    </section>

    <section class="ab-sec">
      <h2>目前的分布</h2>
      <p class="ab-note">共 {total} 篇，按领域：</p>
      <dl class="ab-counts">
        {counts.map((c) => (
          <div>
            <dt>{c.name}</dt>
            <dd>{c.n}</dd>
          </div>
        ))}
      </dl>
      <p class="ab-note">
        另有按阅读顺序编排的<a href="/ai-learning-blog/series/agent-interview-deep">成套系列</a>，
        适合需要形成完整认知时从头读。
      </p>
    </section>

    <section class="ab-sec">
      <h2>技术实现</h2>
      <ul class="ab-list">
        <li><strong>Astro</strong> — 静态站点生成，用内容集合管理分类与系列</li>
        <li><strong>GitHub Pages</strong> — 托管，推送即部署</li>
        <li>源码公开在 <a href="https://github.com/RiceBall-15/ai-learning-blog" target="_blank" rel="noopener">GitHub</a></li>
      </ul>
    </section>

    <section class="ab-sec">
      <h2>联系</h2>
      <ul class="ab-list">
        <li>GitHub — <a href="https://github.com/RiceBall-15" target="_blank" rel="noopener">@RiceBall-15</a></li>
        <li>Email — Li_Yuanzhuo@163.com</li>
      </ul>
      <p class="ab-note">
        文中若有错漏，欢迎开 issue 指出——被纠正过的地方我会补回文章里。
      </p>
    </section>
  </main>
</Layout>

<style>
  .about {
    max-width: 44rem;
    margin: 0 auto;
    padding: 3.5rem 2rem 5rem;
  }

  .ab-eyebrow {
    margin: 0 0 0.6rem;
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .ab-head {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }
  .ab-head h1 {
    margin: 0;
    font-size: clamp(1.7rem, 1.3rem + 1.8vw, 2.4rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .ab-lead {
    margin: 1.2rem 0 0;
    font-size: 1rem;
    line-height: 1.9;
    color: var(--color-text-secondary);
  }

  .ab-sec { margin-top: 2.75rem; }
  .ab-sec h2 {
    margin: 0 0 1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-border);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .ab-list {
    margin: 0;
    padding-left: 1.2rem;
    line-height: 1.9;
    color: var(--color-text-secondary);
  }
  .ab-list li + li { margin-top: 0.4rem; }
  .ab-list li::marker { color: var(--color-text-muted); }
  .ab-list strong { color: var(--color-text-primary); font-weight: 600; }

  .ab-note {
    margin: 1rem 0 0;
    font-size: 0.93rem;
    line-height: 1.85;
    color: var(--color-text-secondary);
  }

  .ab-counts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 0.75rem;
    margin: 0;
  }
  .ab-counts > div {
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .ab-counts dt {
    font-family: var(--font-label);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
  }
  .ab-counts dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-text-primary);
  }

  a {
    color: var(--slate-teal);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 600px) {
    .about { padding: 2.25rem 1.1rem 3rem; }
  }
</style>
