---
import '../styles/global.css';
const { title, description } = Astro.props;
const desc = description ?? 'Agent 运行时、长期记忆、模型网关与评测闭环的深度技术笔记';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={desc} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <title>{title} - AI 深度学习笔记</title>

    <!-- 主题必须在首帧前定下来，否则会闪一下错误的配色 -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var theme = saved
            || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">跳到正文</a>

    <header class="site-header">
      <div class="header-container">
        <a href="/ai-learning-blog/" class="header-logo">
          <span class="logo-mark" aria-hidden="true"></span>
          <span class="logo-text">
            <span class="logo-name">AI 深度学习笔记</span>
            <span class="logo-sub">Agent 工程 · 系统内部机制</span>
          </span>
        </a>

        <nav class="header-nav" aria-label="主导航">
          <a href="/ai-learning-blog/" class="nav-link">首页</a>
          <a href="/ai-learning-blog/series/agent-interview-deep" class="nav-link">面试系列</a>
          <a href="/ai-learning-blog/about" class="nav-link">关于</a>
          <a
            href="https://github.com/RiceBall-15/ai-learning-blog"
            target="_blank"
            rel="noopener"
            class="nav-link nav-github"
            aria-label="GitHub 源码"
          >
            <svg width="17" height="17" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M10 0C4.477 0 0 4.477 0 10c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.341-3.369-1.341-.454-1.155-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0110 4.836a9.59 9.59 0 012.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C17.137 18.163 20 14.418 20 10c0-5.523-4.477-10-10-10z"/>
            </svg>
          </a>
        </nav>

        <button class="theme-toggle" id="themeToggle" aria-label="切换深浅配色">
          <svg class="ti ti-sun" width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2"/>
            <path d="M12 2.6v2M12 19.4v2M2.6 12h2M19.4 12h2M5.4 5.4l1.4 1.4M17.2 17.2l1.4 1.4M18.6 5.4l-1.4 1.4M6.8 17.2l-1.4 1.4"/>
          </svg>
          <svg class="ti ti-moon" width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M20 14.5A8.5 8.5 0 019.5 4a7 7 0 1010.5 10.5z"/>
          </svg>
        </button>
      </div>
    </header>

    <main class="site-main" id="main">
      <slot />
    </main>

    <slot name="footer" />

    <script>
      const toggle = document.getElementById('themeToggle');
      const root = document.documentElement;

      toggle?.addEventListener('click', () => {
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });

      // 用户没手动选过时，跟随系统
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (!localStorage.getItem('theme')) {
          root.setAttribute('data-theme', e.matches ? 'dark' : 'light');
        }
      });
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 200;
        padding: 0.6rem 1rem;
        background: var(--color-surface);
        border: 1px solid var(--signal);
        border-radius: var(--radius-md);
        font-size: 0.85rem;
      }
      .skip-link:focus {
        left: 1rem;
        top: 1rem;
      }

      /* ──── 站点头：一条细规则线，不用阴影 ──── */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: color-mix(in srgb, var(--color-bg) 88%, transparent);
        backdrop-filter: blur(10px) saturate(1.4);
        -webkit-backdrop-filter: blur(10px) saturate(1.4);
        border-bottom: 1px solid var(--color-border);
      }

      .header-container {
        max-width: 70rem;
        margin: 0 auto;
        padding: 0 2rem;
        height: 60px;
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .header-logo {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-right: auto;
        color: var(--color-text-primary);
      }

      /* 标记：一道信号色刻线——与文章里的规格轨同一套语言 */
      .logo-mark {
        width: 3px;
        height: 26px;
        background: var(--signal);
        border-radius: 1px;
        flex: none;
      }

      .logo-text { display: flex; flex-direction: column; line-height: 1.15; }
      .logo-name {
        font-size: 0.98rem;
        font-weight: 600;
        letter-spacing: -0.005em;
      }
      .logo-sub {
        display: none;
        font-family: var(--font-label);
        font-size: 0.7rem;
        letter-spacing: 0.06em;
        color: var(--color-text-muted);
      }
      @media (min-width: 720px) {
        .logo-sub { display: block; }
      }

      .header-nav {
        display: flex;
        align-items: center;
        gap: 0.15rem;
      }

      .nav-link {
        display: inline-flex;
        align-items: center;
        padding: 0.4rem 0.7rem;
        font-family: var(--font-label);
        font-size: 0.88rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        color: var(--color-text-secondary);
        border-radius: var(--radius-md);
        transition: color var(--transition-fast), background var(--transition-fast);
      }
      .nav-link:hover {
        color: var(--signal);
        background: var(--signal-soft);
      }

      .nav-github { padding: 0.4rem 0.55rem; }
      @media (max-width: 560px) {
        .nav-github { display: none; }
      }

      .theme-toggle {
        position: relative;
        width: 34px;
        height: 34px;
        flex: none;
        display: grid;
        place-items: center;
        color: var(--color-text-secondary);
        background: transparent;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        transition: color var(--transition-fast), border-color var(--transition-fast);
      }
      .theme-toggle:hover {
        color: var(--signal);
        border-color: var(--signal);
      }

      .ti {
        position: absolute;
        transition: opacity var(--transition-base), transform var(--transition-base);
      }
      /* 浅色下显示「切到深色」的月亮；深色下显示太阳 */
      .ti-sun  { opacity: 0; transform: scale(0.6) rotate(-45deg); }
      .ti-moon { opacity: 1; transform: scale(1) rotate(0); }
      [data-theme="dark"] .ti-sun  { opacity: 1; transform: scale(1) rotate(0); }
      [data-theme="dark"] .ti-moon { opacity: 0; transform: scale(0.6) rotate(45deg); }

      .site-main { min-height: calc(100vh - 60px); }

      @media (max-width: 640px) {
        .header-container { padding: 0 1.1rem; gap: 0.5rem; }
        .nav-link { padding: 0.4rem 0.5rem; font-size: 0.84rem; }
      }
    </style>
  </body>
</html>
