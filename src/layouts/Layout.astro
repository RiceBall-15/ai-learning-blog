---
import '../styles/global.css';
const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="AI 技术学习博客 - 深入探索大语言模型、Agent系统和AI工程化" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - AI 深度学习笔记</title>
  </head>
  <body>
    <!-- Header -->
    <header class="site-header">
      <div class="header-container">
        <a href="/ai-learning-blog/" class="header-logo">
          <span class="logo-icon">🤖</span>
          <span class="logo-text">AI 深度学习笔记</span>
        </a>
        
        <nav class="header-nav">
          <a href="/ai-learning-blog/" class="nav-link">首页</a>
          <a href="/ai-learning-blog/series/agent-interview-deep" class="nav-link">面试系列</a>
          <a href="/ai-learning-blog/about" class="nav-link">关于</a>
          <a href="https://github.com/RiceBall-15/ai-learning-blog" target="_blank" rel="noopener" class="nav-link nav-github">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M10 0C4.477 0 0 4.477 0 10c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.341-3.369-1.341-.454-1.155-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0110 4.836a9.59 9.59 0 012.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C17.137 18.163 20 14.418 20 10c0-5.523-4.477-10-10-10z"/>
            </svg>
            <span>GitHub</span>
          </a>
        </nav>

        <button class="theme-toggle" id="themeToggle" aria-label="切换主题">
          <span class="theme-icon icon-sun">☀️</span>
          <span class="theme-icon icon-moon">🌙</span>
        </button>
      </div>
    </header>

    <!-- Main Content -->
    <main class="site-main">
      <slot />
    </main>

    <!-- Footer - 在页面中自定义 -->
    <slot name="footer" />

    <script>
      // 主题切换逻辑
      document.addEventListener('DOMContentLoaded', () => {
        const themeToggle = document.getElementById('themeToggle');
        const html = document.documentElement;
        
        // 获取当前主题
        function getTheme() {
          const saved = localStorage.getItem('theme');
          if (saved) return saved;
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        
        // 设置主题
        function setTheme(theme: string) {
          html.setAttribute('data-theme', theme);
          localStorage.setItem('theme', theme);
        }
        
        // 初始化主题
        setTheme(getTheme());
        
        // 切换主题
        themeToggle?.addEventListener('click', () => {
          const current = html.getAttribute('data-theme');
          setTheme(current === 'dark' ? 'light' : 'dark');
        });
        
        // 监听系统主题变化
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
          if (!localStorage.getItem('theme')) {
            setTheme(e.matches ? 'dark' : 'light');
          }
        });
      });
    </script>

    <style>
      /* Header Styles */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--color-border-light);
      }

      [data-theme="dark"] .site-header,
      .dark-mode .site-header {
        background: rgba(15, 23, 42, 0.8);
      }

      .header-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .header-logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--color-text-primary);
        text-decoration: none;
        transition: color var(--transition-fast);
      }

      .header-logo:hover {
        color: var(--color-primary);
      }

      .logo-icon {
        font-size: 1.5rem;
      }

      .logo-text {
        display: none;
      }

      @media (min-width: 640px) {
        .logo-text {
          display: inline;
        }
      }

      .header-nav {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .nav-link {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.5rem 0.75rem;
        color: var(--color-text-secondary);
        font-size: 0.9375rem;
        font-weight: 500;
        text-decoration: none;
        border-radius: var(--radius-md);
        transition: all var(--transition-fast);
      }

      .nav-link:hover {
        color: var(--color-primary);
        background: var(--color-surface-hover);
      }

      .nav-github {
        display: none;
      }

      @media (min-width: 768px) {
        .nav-github {
          display: inline-flex;
        }
      }

      /* Theme Toggle */
      .theme-toggle {
        position: relative;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: all var(--transition-fast);
        overflow: hidden;
      }

      .theme-toggle:hover {
        background: var(--color-surface-hover);
        border-color: var(--color-primary);
      }

      .theme-icon {
        position: absolute;
        font-size: 1.25rem;
        transition: all var(--transition-base);
      }

      .icon-sun {
        opacity: 0;
        transform: rotate(-90deg) scale(0);
      }

      .icon-moon {
        opacity: 1;
        transform: rotate(0deg) scale(1);
      }

      [data-theme="dark"] .icon-sun,
      .dark-mode .icon-sun {
        opacity: 1;
        transform: rotate(0deg) scale(1);
      }

      [data-theme="dark"] .icon-moon,
      .dark-mode .icon-moon {
        opacity: 0;
        transform: rotate(90deg) scale(0);
      }

      /* Main Site */
      .site-main {
        min-height: calc(100vh - 64px);
      }

      /* Responsive */
      @media (max-width: 640px) {
        .header-container {
          padding: 0 1rem;
        }
      }
    </style>
  </body>
</html>
