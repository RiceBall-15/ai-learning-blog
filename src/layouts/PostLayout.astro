---
import Layout from './Layout.astro';

const { post } = Astro.props;
const { Content } = await post.render();

// 格式化日期
const formattedDate = post.data.date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout title={post.data.title}>
  <article class="article-container">
    <!-- Article Header -->
    <header class="article-header">
      <div class="article-meta-top">
        <a href="/ai-learning-blog/" class="back-link">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          返回列表
        </a>
      </div>
      
      <div class="article-info">
        <time class="article-date">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M4.5 2V3.5M11.5 2V3.5M2 5.5H14M3 1.5H13C13.5523 1.5 14 1.94772 14 2.5V13.5C14 14.0523 13.5523 14.5 13 14.5H3C2.44772 14.5 2 14.0523 2 13.5V2.5C2 1.94772 2.44772 1.5 3 1.5Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {formattedDate}
        </time>
        
        {post.data.category && (
          <span class="article-category">{post.data.category}</span>
        )}
      </div>
      
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="article-tags">
          {post.data.tags.map(tag => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
    </header>

    <!-- Article Content -->
    <div class="article-content">
      <Content />
    </div>

    <!-- Article Footer -->
    <footer class="article-footer">
      <div class="share-section">
        <span class="share-label">分享文章：</span>
        <div class="share-buttons">
          <button class="share-btn" data-platform="twitter" aria-label="分享到Twitter">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </button>
          <button class="share-btn" data-platform="copy" aria-label="复制链接">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>
    </footer>
  </article>
</Layout>

<style>
  /* Article Container */
  .article-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }

  @media (max-width: 768px) {
    .article-container {
      padding: 1.5rem 1rem;
    }
  }

  /* Article Header */
  .article-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .article-meta-top {
    margin-bottom: 1rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .article-info {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .article-date {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .article-date svg {
    opacity: 0.7;
  }

  .article-category {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: linear-gradient(135deg, var(--color-primary-light, #818cf8), var(--color-primary, #6366f1));
    color: white;
    border-radius: var(--radius-full, 9999px);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .tag {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    background: var(--color-surface-hover, #f1f5f9);
    color: var(--color-text-muted, #64748b);
    border-radius: var(--radius-full, 9999px);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    transition: all var(--transition-fast, 150ms);
  }

  .tag:hover {
    background: var(--color-primary, #6366f1);
    color: white;
  }

  /* Article Content - vhAstro-Theme Style */
  .article-content {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-text-primary);
  }

  /* Headings - 清晰层级 */
  .article-content :global(h1) {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 2.5rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-primary);
  }

  .article-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 2.5rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .article-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 2rem 0 0.75rem;
  }

  .article-content :global(h4) {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 1.5rem 0 0.5rem;
  }

  /* Paragraphs */
  .article-content :global(p) {
    margin-bottom: 1.5rem;
    color: var(--color-text-secondary);
  }

  /* Links */
  .article-content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-content :global(a:hover) {
    color: var(--color-primary-dark);
  }

  /* Lists */
  .article-content :global(ul),
  .article-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    color: var(--color-text-secondary);
  }

  .article-content :global(li) {
    margin-bottom: 0.5rem;
    color: var(--color-text-secondary);
  }

  /* Blockquote - vhAstro-Theme Style */
  .article-content :global(blockquote) {
    margin: 1.5rem 0;
    padding: 1rem 1.5rem;
    background: var(--color-surface);
    border-left: 4px solid var(--color-primary);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--color-text-secondary);
  }

  .article-content :global(blockquote p) {
    margin-bottom: 0;
  }

  /* Inline Code */
  .article-content :global(code:not(pre code)) {
    background: var(--color-surface-hover);
    color: var(--color-primary);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.875em;
    font-weight: 500;
  }

  /* Code Blocks - vhAstro-Theme Style */
  .article-content :global(pre) {
    background: var(--color-surface) !important;
    border: 1px solid var(--color-border) !important;
    border-radius: var(--radius-lg) !important;
    padding: 0 !important;
    overflow: hidden;
    margin: 1.5rem 0 !important;
    position: relative !important;
  }

  .article-content :global(pre code) {
    display: block;
    padding: 1.25rem !important;
    overflow-x: auto;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.875rem;
    line-height: 1.7 !important;
    background: transparent !important;
    color: var(--color-text-primary) !important;
  }

  /* Shiki code blocks - 支持Astro双主题 */
  .article-content :global(pre.astro-code) {
    background: var(--shiki-light-bg, var(--color-surface)) !important;
    border: 1px solid var(--color-border) !important;
    border-radius: var(--radius-lg) !important;
    padding: 0 !important;
    overflow: hidden;
    margin: 1.5rem 0 !important;
    position: relative !important;
    line-height: 1.7 !important;
  }

  .article-content :global(pre.astro-code code) {
    line-height: 1.7 !important;
  }

  .article-content :global(pre.astro-code .line) {
    line-height: 1.7 !important;
  }

  /* 暗色模式：强制覆盖内联样式 */
  [data-theme="dark"] .article-content :global(pre.astro-code) {
    background: var(--shiki-dark-bg, #24292e) !important;
    color: var(--shiki-dark, #e1e4e8) !important;
  }

  [data-theme="dark"] .article-content :global(pre.astro-code code) {
    color: var(--shiki-dark, #e1e4e8) !important;
  }

  [data-theme="dark"] .article-content :global(pre.astro-code span) {
    color: var(--shiki-dark, #e1e4e8) !important;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .article-content :global(pre.astro-code) {
      background: var(--shiki-dark-bg, #24292e) !important;
      color: var(--shiki-dark, #e1e4e8) !important;
    }
    
    :root:not([data-theme="light"]) .article-content :global(pre.astro-code code) {
      color: var(--shiki-dark, #e1e4e8) !important;
    }
  }

  /* 语言标签 */
  .article-content :global(pre.astro-code[data-language]::before) {
    content: attr(data-language);
    display: block;
    padding: 0.5rem 1rem;
    background: rgba(0, 0, 0, 0.15);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-family: var(--font-mono);
    text-transform: lowercase;
    border-bottom: 1px solid var(--color-border);
  }

  [data-theme="dark"] .article-content :global(pre.astro-code[data-language]::before) {
    background: rgba(0, 0, 0, 0.3);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .article-content :global(pre.astro-code[data-language]::before) {
      background: rgba(0, 0, 0, 0.3);
    }
  }

  /* Line numbers in code blocks */
  .article-content :global(.line-number) {
    color: var(--color-text-muted);
    user-select: none;
    margin-right: 1rem;
    display: inline-block;
    min-width: 1.5rem;
    text-align: right;
  }

  /* Tables - vhAstro-Theme Style */
  .article-content :global(.table-wrapper) {
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    background: transparent;
    border: none;
    border-radius: 0;
    overflow: visible;
  }

  .article-content :global(thead) {
    background: var(--color-surface-hover);
  }

  .article-content :global(th) {
    padding: 0.875rem 1rem;
    text-align: left;
    font-weight: 600;
    color: var(--color-text-primary);
    border-bottom: 2px solid var(--color-border);
  }

  .article-content :global(td) {
    padding: 0.75rem 1rem;
    text-align: left;
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border-light);
  }

  .article-content :global(tr:last-child td) {
    border-bottom: none;
  }

  .article-content :global(tbody tr:hover) {
    background: var(--color-surface-hover);
  }

  /* Images */
  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    margin: 1.5rem 0;
    box-shadow: var(--shadow-md);
  }

  /* Horizontal Rule */
  .article-content :global(hr) {
    margin: 2rem 0;
    border: none;
    border-top: 1px solid var(--color-border);
  }

  /* Article Footer */
  .article-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .share-section {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .share-label {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .share-buttons {
    display: flex;
    gap: 0.5rem;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .share-btn:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
    transform: translateY(-2px);
  }

  /* Copy Button - Inside Code Block */
  .copy-button {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 4px 10px;
    font-size: 12px;
    background: var(--color-surface-hover);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s, background 0.2s;
    z-index: 10;
  }

  :global(pre:hover) .copy-button {
    opacity: 1;
  }

  .copy-button:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }

  .copy-button.copied {
    background: #10b981;
    border-color: #10b981;
    color: white;
  }
</style>

<script>
  function initCodeCopyAndTables() {
    // 包裹表格用于横向滚动
    const tables = document.querySelectorAll('.article-content table');
    tables.forEach((table) => {
      if (table.parentElement?.classList.contains('table-wrapper')) return;
      const wrapper = document.createElement('div');
      wrapper.className = 'table-wrapper';
      table.parentNode?.insertBefore(wrapper, table);
      wrapper.appendChild(table);
    });

    // 代码块复制功能
    const codeBlocks = document.querySelectorAll('.article-content pre');
    
    codeBlocks.forEach((block) => {
      // 跳过已添加按钮的代码块
      if (block.querySelector('.copy-button')) return;
      
      // 确保代码块有相对定位
      block.style.position = 'relative';
      
      // 创建复制按钮
      const copyButton = document.createElement('button');
      copyButton.className = 'copy-button';
      copyButton.innerHTML = '📋 复制';
      copyButton.setAttribute('aria-label', '复制代码');
      block.appendChild(copyButton);
      
      // 点击复制功能
      copyButton.addEventListener('click', async () => {
        const code = block.querySelector('code');
        const text = code ? code.textContent : block.textContent;
        
        try {
          await navigator.clipboard.writeText(text || '');
          copyButton.innerHTML = '✅ 已复制';
          copyButton.classList.add('copied');
          
          setTimeout(() => {
            copyButton.innerHTML = '📋 复制';
            copyButton.classList.remove('copied');
          }, 2000);
        } catch (err) {
          copyButton.innerHTML = '❌ 失败';
          setTimeout(() => {
            copyButton.innerHTML = '📋 复制';
          }, 2000);
        }
      });
    });

    // 分享功能
    document.querySelectorAll('.share-btn').forEach(btn => {
      if (btn.dataset.initialized) return;
      btn.dataset.initialized = 'true';
      btn.addEventListener('click', () => {
        const platform = btn.getAttribute('data-platform');
        const url = window.location.href;
        const title = document.querySelector('h1')?.textContent || '';
        
        if (platform === 'twitter') {
          window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`, '_blank');
        } else if (platform === 'copy') {
          navigator.clipboard.writeText(url).then(() => {
            btn.innerHTML = '✅';
            setTimeout(() => {
              btn.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>`;
            }, 2000);
          });
        }
      });
    });
  }

  // 兼容 Astro SPA 导航和首次加载
  document.addEventListener('astro:page-load', initCodeCopyAndTables);
  document.addEventListener('DOMContentLoaded', initCodeCopyAndTables);
</script>